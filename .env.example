# Bloomberg Terminal connection
BBG_HOST=127.0.0.1
BBG_PORT=8194

# API server
API_HOST=127.0.0.1
API_PORT=8195

# Proxy/playground server
PROXY_HOST=127.0.0.1
PROXY_PORT=8081
SERVE_DIR=./

# OpenBB (optional)
OPENBB_HOST=127.0.0.1
OPENBB_PORT=6900

# AI Assistant (optional — required for chatbot)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# IP whitelist (comma-separated, or * to allow all)
ALLOWED_IPS=*
