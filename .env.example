# Bloomberg Terminal connection
BBG_HOST=127.0.0.1
BBG_PORT=8194

# API server
API_HOST=127.0.0.1
API_PORT=8195

# Proxy/playground server
PROXY_HOST=127.0.0.1
PROXY_PORT=8081
SERVE_DIR=./

# OpenBB (optional)
OPENBB_HOST=127.0.0.1
OPENBB_PORT=6900

# AI Assistant (optional — required for chatbot)
# Supported providers: anthropic, openai, google
# Set the key for whichever provider you use. Users can also enter keys in the UI.
AI_PROVIDER=anthropic
AI_MODEL=

# Anthropic (Claude)
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI (GPT) — also works with any OpenAI-compatible API (Groq, Together, Mistral, etc.)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com

# Google (Gemini)
GOOGLE_API_KEY=
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com

# IP whitelist (comma-separated, or * to allow all)
ALLOWED_IPS=*
